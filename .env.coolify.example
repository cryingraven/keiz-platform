# Coolify environment template for docker-compose.coolify.yml.
# Copy these values into the Coolify resource's Environment Variables.
# MongoDB is Atlas: MONGODB_URI must be the full Atlas connection string.

# ---------- images / ingress ----------
KEIZ_IMAGE_TAG=latest
WEB_PORT=3000

# ---------- public identity (production startup fails if these are localhost) ----------
APP_DOMAIN=app.example.com
WEB_ORIGIN=https://app.example.com
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_ORIGINS=https://app.example.com
WEBAUTHN_RP_NAME=KEIZ

# ---------- Atlas ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/keiz?retryWrites=true&w=majority
MONGODB_DB_NAME=keiz

# ---------- auth ----------
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
COOKIE_SECURE=true

# ---------- NEAR / payments ----------
# CHAIN_NETWORK and NEXT_PUBLIC_CHAIN_NETWORK must match. The web image bakes
# NEXT_PUBLIC_CHAIN_NETWORK at build time; changing it requires a new image.
CHAIN_NETWORK=mainnet
NEXT_PUBLIC_CHAIN_NETWORK=mainnet
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org
PAYMENTS_MODE=mock
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_JWT=
NEAR_INTENTS_REFERRAL=keiz

# ---------- assistant ----------
CHAT_PROVIDER=mastra
NEARAI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=nearai/deepseek-ai/DeepSeek-V4.1-Flash-1017

# ---------- agent wallet (required in production) ----------
# Generate with: openssl rand -hex 32
AGENT_WALLET_MASTER_KEY=replace-with-a-64-character-hex-key
AGENT_ACCOUNT_ID=agent.mainnet

# ---------- OutLayer custody (optional) ----------
OUTLAYER_ENABLED=false
OUTLAYER_NETWORK=mainnet
OUTLAYER_BASE_URL=https://api.outlayer.ai

# ---------- on-chain AR collection (optional) ----------
KEIZ_COLLECT_CODE_HASH=
COLLECT_DEPLOY_ENABLED=false
COLLECT_DEPLOYER_ACCOUNT=
COLLECT_DEPLOYER_PRIVATE_KEY=
COLLECT_WASM_PATH=
COLLECT_DEPLOY_FUNDING_NEAR=4

# ---------- queues / worker ----------
# Leave empty to use the bundled redis service (redis://redis:6379).
# Set this to your managed Redis URL after removing the redis service.
REDIS_URL=
QUEUES_ENABLED=true
QUEUE_PREFIX=keiz
PAYMENT_SWEEP_INTERVAL_MS=30000
INDEXER_INTERVAL_MS=30000

# ---------- demo seeding ----------
# POST /api/demo/seed is OWNER-only and hidden in production unless this is true.
# The dashboard reads the flag from /api/health, so no web rebuild is needed.
DEMO_SEED_ENABLED=false
