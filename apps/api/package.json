{
  "name": "@keiz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "ts-node --project tsconfig.json src/demo/seed-cli.ts",
    "smoke": "ts-node --project tsconfig.json test/smoke.ts",
    "db:memory": "ts-node --project tsconfig.json test/dev-mongo.ts",
    "predev": "pnpm --filter @keiz/shared build",
    "prebuild": "pnpm --filter @keiz/shared build",
    "pretest": "pnpm --filter @keiz/shared build",
    "presmoke": "pnpm --filter @keiz/shared build",
    "smoke:mastra": "ts-node --project tsconfig.json test/mastra-smoke.ts",
    "presmoke:mastra": "pnpm --filter @keiz/shared build",
    "smoke:outlayer": "ts-node --project tsconfig.json test/outlayer-smoke.ts",
    "presmoke:outlayer": "pnpm --filter @keiz/shared build",
    "worker": "nest start --entryFile worker",
    "worker:dev": "nest start --watch --entryFile worker"
  },
  "dependencies": {
    "@keiz/shared": "workspace:*",
    "@mastra/core": "1.81.0",
    "@mastra/memory": "1.40.0",
    "@mastra/mongodb": "1.25.0",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@outlayer/sdk": "0.1.0-alpha.4",
    "@simplewebauthn/server": "13.2.2",
    "bs58": "5.0.0",
    "bullmq": "6.7.2",
    "cookie-parser": "^1.4.7",
    "helmet": "8.3.0",
    "ioredis": "^5.8.2",
    "mongoose": "9.11.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^10.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
