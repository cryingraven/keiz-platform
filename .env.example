# ---------- shared ----------
NODE_ENV=development
APP_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
# Next server-side rewrite target
API_URL=http://localhost:3001

# ---------- api ----------
API_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/keiz
MONGODB_DB_NAME=keiz
JWT_SECRET=change-me-in-production-please-32-chars
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# NEAR
# CHAIN_NETWORK is the server-side source of truth. NEXT_PUBLIC_CHAIN_NETWORK
# must match it; the API also reads NEXT_PUBLIC_CHAIN_NETWORK from this shared
# .env so Next and Nest stay aligned.
CHAIN_NETWORK=testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_JWT=
NEAR_INTENTS_REFERRAL=keiz
# mock | intents   (1Click has NO testnet - mock is the only safe default for dev/CI)
PAYMENTS_MODE=mock

# Mastra + NEAR AI Cloud. Without NEARAI_API_KEY the agent falls back to the
# local provider (same tools, deterministic answers) so demos stay offline.
CHAT_PROVIDER=mastra
NEARAI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=nearai/deepseek/deepseek-v4.1-flash-1017

# Agent wallet (32-byte hex or base64). Generate: openssl rand -hex 32
AGENT_WALLET_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AGENT_ACCOUNT_ID=agent.testnet

# ---------- NEAR Auth (Auth0 / MPC) ----------
# Testnet ships a shared Auth0 client; mainnet needs an approved client id.
# Signing a NEP-413 message needs a FUNDED relayer account that submits the
# fast-auth `sign` call. Without it the API returns 503 and the UI shows an error.
NEXT_PUBLIC_NEAR_AUTH_ENABLED=true
NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl
# Optional overrides. Leave unset to derive from NEXT_PUBLIC_CHAIN_NETWORK.
# NEXT_PUBLIC_NEAR_AUTH_NETWORK=testnet
# NEXT_PUBLIC_NEAR_AUTH_CONTRACT_ID=fast-auth.testnet
# NEXT_PUBLIC_NEAR_AUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
# NEXT_PUBLIC_NEAR_AUTH_RPC_URL=https://rpc.testnet.near.org
# NEXT_PUBLIC_NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# NEXT_PUBLIC_NEAR_AUTH_SIGNING_AUDIENCE=auth0.jwt.fast-auth.testnet

NEAR_AUTH_NETWORK=testnet
NEAR_AUTH_CONTRACT_ID=fast-auth.testnet
NEAR_AUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
NEAR_AUTH_RPC_URL=https://rpc.testnet.near.org
NEAR_AUTH_RELAYER_ACCOUNT_ID=relayer.testnet
NEAR_AUTH_RELAYER_PRIVATE_KEY=ed25519:replace-with-a-funded-relayer-key
NEAR_AUTH_RELAYER_MAX_GAS=300000000000000
# Daily gas-abuse guardrails for the public relay endpoint.
NEAR_AUTH_RELAYER_DAILY_LIMIT=1000
NEAR_AUTH_RELAYER_DAILY_LIMIT_PER_USER=50
# Optional: restrict relayed sign calls to this Auth0 guard id.
# NEAR_AUTH_GUARD_ID=jwt#https://login.testnet.fast-auth.com/
# Optional: refuse to relay when the relayer balance is below this yoctoNEAR amount.
# NEAR_AUTH_RELAYER_MIN_BALANCE=100000000000000000000000

# ---------- on-chain AR collection ----------
# Deploy contracts/keiz-collect and allowlist the destination token in the
# contract before enabling these.
KEIZ_COLLECT_CONTRACT_ID=keiz-collect.testnet
# The workspace that owns the deployed collect contract (one per workspace).
KEIZ_COLLECT_ORG_ID=000000000000000000000000
# NEP-141 token contract that the collect contract accepts, and its decimals.
KEIZ_COLLECT_TOKEN_CONTRACT=usdc.testnet
KEIZ_COLLECT_ASSET_DECIMALS=6
KEIZ_COLLECT_ASSET_ID=nep141:usdc.testnet

# ---------- OutLayer agent custody ----------
# The SDK's built-in hosts are stale; always set OUTLAYER_BASE_URL explicitly.
# Intents (cross-chain withdrawals) are MAINNET-ONLY; testnet supports
# register/address/balance/NEAR calls but returns 503 for intents endpoints.
OUTLAYER_ENABLED=false
OUTLAYER_NETWORK=testnet
OUTLAYER_BASE_URL=https://testnet-api.outlayer.ai

# ---------- queues / worker ----------
# Start Redis with `docker compose up -d redis`, then run the worker:
#   pnpm --filter @keiz/api worker:dev
REDIS_URL=redis://127.0.0.1:6379
QUEUES_ENABLED=true
QUEUE_PREFIX=keiz
PAYMENT_SWEEP_INTERVAL_MS=30000
INDEXER_INTERVAL_MS=30000

# ---------- web ----------
# Single frontend switch: mainnet | testnet. Drives wallet login, NEAR Auth
# defaults and the dashboard network badge. Keep the API's CHAIN_NETWORK and
# NEAR_AUTH_NETWORK aligned when changing this value.
NEXT_PUBLIC_CHAIN_NETWORK=testnet
# Legacy wallet-only fallback; NEXT_PUBLIC_CHAIN_NETWORK wins when set.
# NEXT_PUBLIC_NEAR_NETWORK=testnet
