# syntax=docker/dockerfile:1

# Build context is the repository root: the API depends on the @keiz/shared
# workspace package and pnpm lockfile.
FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @keiz/shared build \
 && pnpm --filter @keiz/api build \
 && pnpm --filter @keiz/api deploy --prod --legacy /prod/api

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Atlas and the NEAR RPC endpoints are HTTPS-only.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=node:node /prod/api ./

USER node
EXPOSE 3001

# The same image also runs the BullMQ worker with:
#   docker run ... node dist/worker.js
CMD ["node", "dist/main.js"]
